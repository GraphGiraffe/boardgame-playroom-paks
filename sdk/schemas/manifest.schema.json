{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayRoom SDK pack manifest",
  "type": "object",
  "required": ["id", "version", "name", "engineApi", "viewApi", "stateVersion"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "description": "Stable pack ID. Use the same ID in the rules definition."
    },
    "name": { "$ref": "settings.schema.json#/definitions/text" },
    "replaces": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
    "shortName": { "$ref": "settings.schema.json#/definitions/text" },
    "tagline": { "$ref": "settings.schema.json#/definitions/text" },
    "description": { "$ref": "settings.schema.json#/definitions/text" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*)?$",
      "examples": ["0.1.0", "0.1.0-preview.1"]
    },
    "engineApi": { "const": 4, "default": 4 },
    "viewApi": { "const": 3, "default": 3 },
    "stateVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "execution": { "const": "isolated-v1", "default": "isolated-v1" },
    "defaultLanguage": { "type": "string", "default": "ru" },
    "estimatedDurationMin": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "number", "minimum": 0 } }
      ],
      "description": "Duration or duration range in minutes. The application formats the unit."
    },
    "settings": {
      "description": "Use settings.json for match settings. The compiler embeds it in the installable manifest.",
      "default": "settings.json",
      "oneOf": [
        { "$ref": "#/definitions/jsonPath" },
        { "$ref": "settings.schema.json" }
      ]
    },
    "sourceModules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": { "$ref": "#/definitions/paths" },
        "view": { "$ref": "#/definitions/paths" },
        "settings": {
          "allOf": [{ "$ref": "#/definitions/jsonPath" }],
          "description": "Earlier settings reference. New manifests use the top-level settings property."
        },
        "locales": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/jsonPath" }
          },
          "examples": [{ "ru": ["lang/ru.json"], "en": ["lang/en.json"] }]
        },
        "rulebooks": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "examples": [{ "ru": "lang/rules.md" }]
        }
      }
    },
    "capabilities": { "type": "object" },
    "sdkFeatures": { "$ref": "#/definitions/paths" },
    "sharedAssets": { "$ref": "#/definitions/paths" },
    "sharedAssetPacks": { "$ref": "#/definitions/paths" },
    "sharedDomain": { "$ref": "#/definitions/paths" },
    "playModes": { "type": "array", "items": { "type": "object" } },
    "tileTheme": { "enum": ["green", "coral", "blue", "gold", "violet"] },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "changes"],
        "properties": {
          "version": { "type": "string" },
          "changes": { "type": "array", "items": { "$ref": "settings.schema.json#/definitions/text" } }
        }
      }
    }
  },
  "not": {
    "required": ["sourceModules", "settings"],
    "properties": { "sourceModules": { "required": ["settings"] } }
  },
  "definitions": {
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "jsonPath": {
      "type": "string",
      "pattern": "^(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?:[A-Za-z0-9_. -]+\\/)*[A-Za-z0-9_. -]+\\.json$"
    }
  }
}
