{
  "id": "klondike",
  "version": "0.1.5",
  "name": "Косынка",
  "category": "solitaire",
  "estimatedDuration": "10–30 мин",
  "tagline": "Разбери семь столбцов и собери четыре масти.",
  "capabilities": {
    "hands": false,
    "surfaces": [
      "combined",
      "table",
      "player"
    ],
    "quietActions": [
      "move",
      "flip",
      "recycle",
      "undo"
    ],
    "presentation": {
      "entityMotion": true
    }
  },
  "rules": "rules.js",
  "view": "view.js",
  "styles": "styles.css",
  "sharedUi": true,
  "engineApi": 3,
  "stateVersion": 1,
  "viewApi": 2,
  "tileTheme": "green",
  "tags": [
    "cards"
  ],
  "playModes": [
    {
      "id": "solo",
      "players": [
        1
      ],
      "teams": false
    }
  ],
  "sharedDomain": [
    "standard-deck",
    "solitaire"
  ],
  "sourceModules": {
    "rules": [
      "domain/game.js",
      "presentation/scene.js"
    ],
    "view": [
      "presentation/scene.js"
    ],
    "locales": {
      "ru": [
        "locales/ru/game.json"
      ]
    }
  },
  "sharedAssetPacks": [
    "mini-split-deck",
    "solitaire-board",
    "standard-deck"
  ],
  "skinFamilies": [
    "card-face",
    "card-back"
  ],
  "defaultSkins": {
    "card-face": "compact-index"
  },
  "settings": [
    {
      "key": "draw",
      "label": "Добор",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "control": "slider",
      "help": "За один добор открывается до трёх карт; доступна только верхняя карта сброса."
    },
    {
      "key": "scoring",
      "label": "Счёт",
      "default": "standard",
      "options": [
        {
          "value": "standard",
          "label": "Обычный"
        },
        {
          "value": "none",
          "label": "Без счёта"
        },
        {
          "value": "vegas",
          "label": "Vegas"
        }
      ],
      "control": "slider",
      "help": "Правила ХОД на основе классического пасьянса; точное соответствие арифметике Windows XP не заявлено."
    },
    {
      "key": "undo",
      "label": "Отмена",
      "default": "last",
      "options": [
        {
          "value": "off",
          "label": "Выкл"
        },
        {
          "value": "last",
          "label": "Последнее"
        },
        {
          "value": "history",
          "label": "История"
        }
      ],
      "control": "slider",
      "help": "До 100 сохранённых действий. В Пауке режим «Последнее» не переходит через раздачу или снятие серии. Отмена стоит 1 очко в Пауке, 2 в Косынке."
    },
    {
      "key": "maxPasses",
      "label": "Проходов колоды",
      "default": "0",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "0",
          "label": "∞"
        }
      ],
      "control": "slider",
      "help": "Первый проход включён. В Vegas: 1 проход при доборе 1; 3 прохода при доборе 3."
    },
    {
      "key": "autoFlip",
      "label": "Открытие карт",
      "default": "auto",
      "options": [
        {
          "value": "manual",
          "label": "Вручную"
        },
        {
          "value": "auto",
          "label": "Авто"
        }
      ],
      "control": "slider",
      "help": "Автооткрытие является частью того же действия и отменяется вместе с ним."
    },
    {
      "key": "autoCollect",
      "label": "Автосбор",
      "default": "button",
      "options": [
        {
          "value": "off",
          "label": "Выкл"
        },
        {
          "value": "button",
          "label": "Двойное нажатие"
        }
      ],
      "control": "slider",
      "help": "Дважды нажмите на пустое поле: доступные открытые карты последовательно перемещаются в дома. Запас не раздаётся; закрытые карты открываются только при включённом автооткрытии."
    }
  ],
  "ruleGroups": [
    {
      "label": "Правила",
      "fields": [
        "preset",
        "draw",
        "scoring",
        "undo",
        "maxPasses",
        "autoFlip",
        "autoCollect"
      ]
    }
  ],
  "presetSetting": {
    "label": "Режим",
    "options": [
      {
        "value": "classic",
        "label": "Классический"
      }
    ]
  }
}
