{
  "id": "ludo",
  "version": "0.2.0-rc.1",
  "name": "Лудо",
  "category": "board",
  "estimatedDuration": "20–40 мин",
  "tagline": "Четыре фишки домой.",
  "capabilities": {
    "hands": false,
    "surfaces": [
      "combined",
      "table",
      "player"
    ]
  },
  "rules": "rules.js",
  "view": "view.js",
  "styles": "styles.css",
  "sharedUi": true,
  "sharedAssets": [
    "die.svg",
    "round-token.svg"
  ],
  "engineApi": 3,
  "stateVersion": 2,
  "viewApi": 2,
  "tileTheme": "green",
  "tags": [
    "board",
    "race"
  ],
  "playModes": [
    {
      "id": "individual",
      "players": [
        2,
        3,
        4
      ],
      "teams": false
    },
    {
      "id": "teams",
      "players": [
        4
      ],
      "teams": true
    }
  ],
  "settings": [
    {
      "key": "diceCount",
      "label": "Бросается N кубиков",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "help": "Кубики бросаются вместе, но каждый используется отдельно. Одной фишкой можно использовать несколько кубиков."
    },
    {
      "key": "sixReroll",
      "label": "Перебрасывать шестёрки",
      "default": "on",
      "options": [
        {
          "value": "on",
          "label": "Да"
        },
        {
          "value": "off",
          "label": "Нет"
        }
      ],
      "help": "После использования доступных ходов перебрасываются только кубики с шестёрками. Остальные не перебрасываются."
    },
    {
      "key": "guaranteedExit",
      "label": "Гарантированный выход после трёх неудач",
      "default": "on",
      "options": [
        {
          "value": "on",
          "label": "Да"
        },
        {
          "value": "off",
          "label": "Нет"
        }
      ],
      "help": "Если все незавершённые фишки на базе, после трёх неудачных наборов одну можно вывести любым кубиком."
    },
    {
      "key": "startPawn",
      "label": "Одна фишка на старте",
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": "Нет"
        },
        {
          "value": "on",
          "label": "Да"
        }
      ],
      "help": "В начале партии у каждого игрока одна фишка сразу стоит на стартовой клетке; остальные остаются на базе."
    },
    {
      "key": "endMode",
      "label": "Завершение партии",
      "default": "winner",
      "help": "До победителя — сразу после финиша. Последний раунд — оставшиеся игроки завершают текущий круг от первого игрока; закончившие в этом круге делят победу. До последнего — все доводят фишки до финиша, места определяются порядком финиша. В командах Лудо финиширует вся команда.",
      "options": [
        {
          "value": "winner",
          "label": "До победителя"
        },
        {
          "value": "round",
          "label": "Последний раунд"
        },
        {
          "value": "last",
          "label": "До последнего"
        }
      ]
    },
    {
      "key": "maxRounds",
      "label": "Предел раундов",
      "default": "0",
      "help": "Раунд — полный круг от первого игрока. При достижении предела все заканчивают текущий круг. Если ещё никто не финишировал, сравниваются фишки дома (в командах — сумма команды); равенство означает общее место.",
      "options": [
        {
          "value": "0",
          "label": "Без ограничения"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "20",
          "label": "20"
        },
        {
          "value": "50",
          "label": "50"
        }
      ]
    }
  ],
  "sourceModules": {
    "rules": [
      "domain/board.js",
      "domain/game.js",
      "presentation/scene.js"
    ],
    "view": [
      "domain/board.js",
      "presentation/scene.js"
    ],
    "locales": {
      "ru": [
        "locales/ru/game.json"
      ]
    }
  },
  "teamLayouts": {
    "teams": {
      "seatTeams": [
        "blue",
        "red",
        "blue",
        "red"
      ],
      "teams": [
        {
          "id": "blue",
          "label": "синяя",
          "color": "#668fad",
          "colorRole": "side.blue"
        },
        {
          "id": "red",
          "label": "красная",
          "color": "#ce735d",
          "colorRole": "side.red"
        }
      ]
    }
  },
  "sharedDomain": [
    "token-layout",
    "end-policy"
  ]
}
