  "playModes": [
    {
      "id": "individual",
      "players": [
        2,
        3,
        4,
        5,
        6
      ],
      "teams": false
    }
  ],
  "settings": [
    {
      "key": "variant",
      "label": "Режим",
      "default": "throwin",
      "options": [
        {
          "value": "simple",
          "label": "Простой"
        },
        {
          "value": "throwin",
          "label": "Подкидной"
        },
        {
          "value": "transfer",
          "label": "Переводной"
        }
      ],
      "help": "Простой: по пять карт, заранее составленный заход из одной карты, пары с третьей или двух пар с пятой, без подкидывания. Подкидной: по шесть, можно подкидывать достоинства со стола. Переводной: дополнительно можно перевести атаку до первой защиты.",
      "control": "slider"
    },
    {
      "key": "deck",
      "label": "Колода",
      "default": "54",
      "options": [
        {
          "value": "36",
          "label": "36 карт"
        },
        {
          "value": "52",
          "label": "52 карты"
        },
        {
          "value": "54",
          "label": "54 карты"
        }
      ],
      "help": "36 карт — от шестёрок до тузов; 52 — от двоек до тузов; 54 — те же 52 и два джокера. Масти и число карт не меняют выбранный вариант боя.",
      "control": "select"
    },
    {
      "key": "jokerMode",
      "label": "Джокеры",
      "default": "color",
      "options": [
        {
          "value": "color",
          "label": "По цвету"
        },
        {
          "value": "universal",
          "label": "Универсальные"
        }
      ],
      "visibleWhen": {
        "deck": "54"
      },
      "help": "Только для колоды 54. «По цвету»: джокер цвета козыря старше всех; другой бьёт некозырные карты своего цвета и сам бьётся козырем. «Универсальные»: оба бьют обычные карты, красный бьёт чёрного.",
      "control": "slider"
    },
    {
      "key": "endCondition",
      "label": "Завершение партии",
      "default": "lastfool",
      "options": [
        {
          "value": "firstout",
          "label": "До победителя"
        },
        {
          "value": "lastfool",
          "label": "До последнего"
        }
      ],
      "help": "До победителя: после окончания взятки и исчерпания колоды первый вышедший побеждает. До последнего: игра продолжается до одного оставшегося с картами.",
      "control": "slider"
    }
  ],
