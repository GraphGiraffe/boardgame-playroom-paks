{
  "id": "oldmaid",
  "version": "0.3.3",
  "name": "Акулина",
  "category": "cards",
  "estimatedDuration": "10–20 мин",
  "tagline": "Разбирай пары. Берегись последней дамы.",
  "capabilities": {
    "hands": true,
    "surfaces": [
      "combined",
      "table",
      "player"
    ]
  },
  "rules": "rules.js",
  "view": "view.js",
  "styles": "styles.css",
  "sharedUi": true,
  "settings": [
    {
      "key": "deck",
      "label": "Колода",
      "default": "36",
      "options": [
        {
          "value": "36",
          "label": "35 карт"
        },
        {
          "value": "52",
          "label": "51 карта"
        }
      ],
      "help": "В игре 35 или 51 карта: из исходной колоды 36 или 52 карты убрана дама треф.",
      "control": "select"
    },
    {
      "key": "drawFrom",
      "label": "Брать карту",
      "default": "any",
      "options": [
        {
          "value": "any",
          "label": "У любого"
        },
        {
          "value": "next",
          "label": "У следующего"
        }
      ],
      "help": "Выберите любого соперника с картами либо только следующего по кругу. Пустые руки пропускаются.",
      "control": "slider"
    },
    {
      "key": "endMode",
      "label": "Завершение партии",
      "default": "last",
      "help": "«До победителя» — партия заканчивается при первом выходе с пустой рукой. «До последнего» — продолжается до одного участника с Акулиной. Более ранний выход даёт более высокое место; вышедшие одним действием делят место.",
      "options": [
        {
          "value": "winner",
          "label": "До победителя"
        },
        {
          "value": "last",
          "label": "До последнего"
        }
      ],
      "control": "slider"
    }
  ],
  "engineApi": 4,
  "stateVersion": 4,
